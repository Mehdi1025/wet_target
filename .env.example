# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# New format (recommended)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Legacy format (still supported)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_xxx
# Legacy JWT key (recommended for admin/server) — Settings > API > Legacy API Keys > service_role
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin panel (local)
ADMIN_USERS=adam:password,mahdi:password
ADMIN_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long

# Target OS CRM (server only)
CRM_WON_LEADS_URL=https://your-target-os.example.com/api/won-leads
AGENCY_API_SECRET=your-agency-api-secret
